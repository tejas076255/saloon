# SalonDesk Backend Configuration
PROJECT_NAME="SalonDesk Premium SaaS"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Primary Supabase or PostgreSQL connection string
# e.g., postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="sqlite:///./salondesk.db"

# Optional Supabase Auth integration credentials
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-or-service-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Development Mode Flag for SaaS Subscriptions
DEV_MODE_PAYMENTS=true
